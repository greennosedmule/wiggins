<?xml version="1.0" encoding="utf-8"?>
<!--
  The hub URL is user-configured and may be ws:// on a LAN or VPN, where
  HiveMind's own payload encryption protects the traffic. Wiggins itself
  requires wss:// for every auth mode other than "none" (see HubUrl).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
